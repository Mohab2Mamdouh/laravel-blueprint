{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mohab/laravel-blueprint",
    "description": "A Laravel starter package providing repository pattern commands, seeders, settings, base models, traits, and more.",
    "keywords": ["laravel", "starter", "repository-pattern", "scaffolding", "blueprint"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mohab Mamdouh",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "spatie/laravel-translatable": "^6.0"
    },
    "suggest": {
        "kreait/firebase-php": "Required to use FcmHelper for sending Firebase Cloud Messaging push notifications (^7.0)."
    },
    "autoload": {
        "psr-4": {
            "Mohab\\LaravelBlueprint\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mohab\\LaravelBlueprint\\BlueprintServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}