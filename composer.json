{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "blueprint-php/laravel",
    "description": "A layered foundation for Laravel apps: repositories, platform-split services/requests/resources, a JSON response envelope, tracked seeders, migration and query macros, model traits and code generators.",
    "keywords": [
        "laravel",
        "repository-pattern",
        "scaffolding",
        "generators",
        "service-layer",
        "seeders",
        "api"
    ],
    "homepage": "https://github.com/Mohab2Mamdouh/laravel-blueprint",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mohab Mamdouh",
            "homepage": "https://github.com/Mohab2Mamdouh",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Mohab2Mamdouh/laravel-blueprint/issues",
        "source": "https://github.com/Mohab2Mamdouh/laravel-blueprint"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "spatie/laravel-translatable": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "stancl/tenancy": "Lets the tracked seed commands (seed, seed:rollback, seed:reset, seed:status) run per tenant database with --tenant."
    },
    "autoload": {
        "psr-4": {
            "BlueprintPhp\\Laravel\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BlueprintPhp\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "BlueprintPhp\\Laravel\\BlueprintServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
